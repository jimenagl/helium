--- a/components/policy/core/common/helium_opinionated_policy_provider.cc
+++ b/components/policy/core/common/helium_opinionated_policy_provider.cc
@@ -22,6 +22,24 @@ void HopProvider::RefreshPolicies(Policy
   PolicyBundle bundle;
   PolicyMap& policy_map = bundle.Get(PolicyNamespace(POLICY_DOMAIN_CHROME, std::string()));

+  // Block all URLs by default
+  base::Value::List blocklist;
+  blocklist.Append("*");
+  Set(policy_map, policy::key::kURLBlocklist,
+      POLICY_LEVEL_MANDATORY, base::Value(std::move(blocklist)));
+
+  // Allow only Galadio Odoo instances
+  base::Value::List allowlist;
+  allowlist.Append("https://odoo-galadio.galadio.local/*");
+  allowlist.Append("https://odoo-mx.galadio.local/*");
+  allowlist.Append("https://odoo-rdp.galadio.local/*");
+  allowlist.Append("https://odoo-uk.galadio.local/*");
+  Set(policy_map, policy::key::kURLAllowlist,
+      POLICY_LEVEL_MANDATORY, base::Value(std::move(allowlist)));
+
+  // Set homepage and startup page to the main Odoo instance
+  Set(policy_map, policy::key::kHomepageLocation,
+      POLICY_LEVEL_MANDATORY, base::Value("https://odoo-galadio.galadio.local"));
+
   UpdatePolicy(std::move(bundle));
 }

